# Copy to .env and fill in. Never commit .env. See the README for what each one is.

# Required
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/connuit
REDIS_URL=rediss://default:PASSWORD@your-redis.upstash.io:6379
JWT_SECRET=at-least-32-random-characters
ENCRYPTION_KEY=64-hex-characters-from-randomBytes-32
GEMINI_API_KEY=your-gemini-api-key

# Optional (defaults shown)
FRONTEND_URL=http://localhost:5173
# PORT=5000
# LLM_MODEL=gemini-3.5-flash-lite
# AI_CALLS_PER_USER_PER_DAY=50
# AI_CALLS_PER_DAY_TOTAL=450

# Telegram triggers
# TELEGRAM_WEBHOOK_SECRET=a-long-random-string
# PUBLIC_API_URL=https://your-api.example.com

# Gmail (Google OAuth "Web application" client)
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
